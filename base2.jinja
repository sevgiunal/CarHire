<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% block head %}
    <title>{% block title %}{% endblock %}</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/style/footer.css">

    {% endblock %}
</head>
<body>
    {% include 'partials/navbar.jinja' %}
    <div id="content">
    {% block content %}{% endblock %}
    </div>
    <div id="footer">
    {% block footer %}
        <a href="search.html">
            <img src="https://img.icons8.com/ios7/600/search.png" alt="Search Icon">
            Search
        </a>
        <a href="rentals.html">
            <img src="https://www.iconpacks.net/icons/2/free-car-icon-2897-thumb.png" alt="Rentals Icon">
            Rentals
        </a>
        <a href="profile.html">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQv_oL1l60gN7zHc_fMS11OeFR-mLDi3DgjNg&s" alt="Profile Icon">
            Profile
        </a>
        <a href="support.html">
            <img src="https://static.vecteezy.com/system/resources/previews/015/911/602/non_2x/customer-support-icon-outline-style-vector.jpg" alt="Support Icon">
            Support
        </a>
    {% endblock %}
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
